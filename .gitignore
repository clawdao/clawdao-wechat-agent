# ── 密钥与环境变量（严禁入库） ──
config.json
config.local.json
.env
.env.local
.env.*.local
*.local
credentials.json
# 注：.env.example 是脱敏模板，允许入库（白名单例外）

# ── Python ──
__pycache__/
*.pyc
.venv/
venv/

# ── 备份/临时文件 ──
*.bak
*.tmp

# ── 产物 ──
output/*
!output/.gitkeep
outputs/*
# 例外：保留品牌素材（封面图/品牌头图/分享小图/共享插图）
!outputs/亿检链_*.png
!outputs/inline_*.png
!outputs/illustration_*.png
!outputs/正式版_*.md
!outputs/重建版_*.md
!outputs/创意 001.md
# 例外：品牌头图上传缓存
!outputs/.brand_header_cache.json
.clawdao-uploads/
