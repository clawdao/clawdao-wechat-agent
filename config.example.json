{
  "api": {
    "base_url": "https://api.minimaxi.com/v1",
    "api_key": "auto-from-auth-json",
    "chat_model": "MiniMax-M3",
    "image_model": "minimax-image-01"
  },
  "minimax_image": {
    "enabled": true,
    "base_url": "https://api.minimaxi.com",
    "api_key": "auto-from-auth-json",
    "model": "image-01",
    "endpoint": "/v1/image_generation",
    "size": "1024x1024",
    "default_params": {
      "width": 1024,
      "height": 1024,
      "n": 1
    }
  },
  "seedream": {
    "access_key": "your-volcengine-access-key",
    "secret_key": "your-base64-encoded-secret-key",
    "endpoint": "https://visual.volcengineapi.com",
    "model": "high_aes_general_v30l_zt2i",
    "enabled": false,
    "use_as_fallback": true
  },
  "wechat": {
    "appid": "YOUR_APPID",
    "appsecret": "YOUR_APPSECRET",
    "secret": "YOUR_APPSECRET",
    "token_url": "https://api.weixin.qq.com/cgi-bin/token",
    "draft_url": "https://api.weixin.qq.com/cgi-bin/draft/add"
  },
  "cover": {
    "width": 900,
    "height": 383,
    "bg_color": "#0a2e7a",
    "text_color": "#ffffff",
    "accent_color": "#f24c3a",
    "brand_name": "亿检链",
    "brand_en": "LIMSCHAIN",
    "parent_brand": "利姆斯科技旗下品牌",
    "logo_path": "images/亿检链_头图横幅_官方_1600x640.png",
    "source_header_image": "images/亿检链_头图横幅_官方_1600x640.png"
  },
  "output": {
    "dir": "output",
    "article_prefix": "article",
    "cover_prefix": "cover"
  }
}
